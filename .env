PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true&serverSelectionTimeoutMS=2000&appName=mongosh+2.5.8

# JWT Secrets — make these long random strings, one per entity
JWT_USER_SECRET=your_user_secret_here
JWT_ADMIN_SECRET=your_admin_secret_here
JWT_HOSPITAL_SECRET=your_hospital_secret_here
JWT_EXPIRES_IN=7d